%%{init: {'flowchart': {'curve': 'linear'}}}%%
flowchart TD
    Start([Начало]) --> A[Пользователь открывает форму таблицы]
    A --> B{Есть активная сессия?}
    B -- "Нет" --> B1[Редирект на главную страницу] --> End([Конец])
    B -- "Да" --> C[auth.require_auth проверяет сессию]
    C --> D[TemplateService.getActiveTemplate]
    D --> E{Шаблон активен?}
    E -- "Нет" --> E1[Отобразить 'нет активного шаблона'] --> End
    E -- "Да" --> F[Рендер формы с Template.getStructure]
    F --> G[Пользователь вводит значения]
    G --> H[POST в save_table]
    H --> I[Валидация входных данных]
    I --> J{Данные корректны?}
    J -- "Нет" --> J1[Ответ: ошибка валидации] --> End
    J -- "Да" --> K[TemplateService.saveFilledData]
    K --> L[INSERT filled_data в БД]
    L --> M[Ответ: success] --> End

    Auth -- "пускает админа" --> AdminView --> SaveTpl --> TplSvc
    Auth -- "пускает минэка" --> MinecView --> DB
    MinecView --> ChartData --> DB
    Minec -- "выгрузка" --> Export --> DB

    User -- "обращение" --> Feedback --> DB
